#!name=微信
#!desc=过滤微信公众号文章内广告（推广位 / 互选商品卡 / 搜索词推荐接口，mp.weixin.qq.com/mp/* 直接返回空 JSON）与朋友圈广告素材域 wxs.qq.com；纯本地规则、零远程脚本、不上报、不联网；需开启 MITM 并信任证书；规则更新 2026-11-05 15:22
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/wechat.png
#!tag=去广告
#!system=ios
#!date=2026-11-05 15:22

# ============================================================
# 微信（公众号）去广告 —— 2026-11-05 按用户指定的外部插件内容整体替换
#
# 来源：hub.kel***.one 的「微信公众号去广告」（作者 @RuC6，版本 2026-10-02 13:57:49；
#       截图中主域被省略号截断，此处照原样标注）
#       原插件的三段（主机名 / Rules / 复写）已逐条对应到下面的 [MITM] / [Rule] / [Rewrite]，
#       正则、动作、顺序均未改动。原插件为 Surge 写法
#       「request if ${url} ~= /…/i then reject_dict(200)」，
#       本仓库译为 Loon 的「正则 reject-dict」（Loon 的 reject-dict 即返回 200 + `{}`）。
#
# 相比上一版（2026-10-21 的「微信全量版」）本次只保留公众号这一支：
#   - 移除了约 40 个第三方小程序（收钱吧 / 猫眼 / 捷停车 / 美团等）的 Banner 与弹窗改写
#   - 移除了 wxsnsdy / wxsmsdy / wxsnsdythumb 三个单独列出的广告子域（已由下面的
#     DOMAIN-SUFFIX,wxs.qq.com 整段覆盖）
#   - MITM 主机从 57 个收缩到 1 个
#
# ⚠️ 与上一版相反，本版按指定内容收录了 DOMAIN-SUFFIX,wxs.qq.com 整段拦截：
#    该域承载朋友圈广告素材，同时也可能承载部分小程序静态资源。
#    若发现小程序图片 / 视频加载不出来，把 [Rule] 段里那一行删掉即可。
#
# 本仓库补充（非原插件内容，各 1 行，可删除）：
#   - AND,((DOMAIN,mp.weixin.qq.com),(PROTOCOL,QUIC)),REJECT
#     两条复写都依赖 MITM 解密，而 QUIC 走 UDP 无法解密；不拦会让规则静默失效
#     （表现为「页面正常、广告还在」），这是本仓库所有 MITM 插件的固定配套。
#
# 边界：只处理「网络可拦截」的广告。客户端自渲染的浮层（如 PopLayer、开屏浮层）不覆盖。
# ============================================================

[Rule]
# 微信广告素材域（朋友圈广告视频 / 缩略图等）—— 原插件 Rules 段：wxs.qq.com DOMAIN-SUFFIX REJECT
DOMAIN-SUFFIX,wxs.qq.com,REJECT

# 强制 mp.weixin.qq.com 走 TCP，否则 QUIC 会绕过 MITM 让下面的复写静默失效（本仓库补充行）
AND,((DOMAIN,mp.weixin.qq.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# 公众号文章页内的推广位 / 互选商品卡 / 监控 / 信息流 / 相关阅读接口
# 原插件：request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? reject-dict

# 文章页底部「相关搜索词」推荐位
# 原插件：request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword reject-dict

[MITM]
hostname = mp.weixin.qq.com
