#!name=拼多多
#!desc=过滤拼多多 App 开屏广告；纯本地规则，零远程脚本、不上报、不联网。需开启 Loon MITM 并信任证书。；规则更新 2026-10-07 10:53
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/pinduoduo.jpg
#!tag=去广告
#!system=ios

[Rule]
# 开屏广告素材直连下发（限拼多多 UA，避免影响其他 App）
AND,((URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?"),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?"),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
# 开屏接口域名 QUIC 阻断（该域已开 MITM，按仓库规范配套）
AND,((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# 开屏广告接口（核心）：返回空体 200，App 跳过开屏
^https?://api\.(pinduoduo|yangkeduo)\.com/api/cappuccino/splash reject-200

[MITM]
hostname = api.pinduoduo.com, api.yangkeduo.com
