#!name=闲鱼
#!desc=仅拦截闲鱼 App 开屏广告（冷启动全屏广告）；不改写首页、搜索、同城、社区、我的、订单页等任何其他内容
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/xianyu.jpg
#!tag=去广告
#!system=ios
#!date = 2026-10-06 22:35

# ============================================================
# 本插件只做一件事：拦截闲鱼开屏广告。
#
# 【2026-10-06 精简版】应需求移除了此前对首页信息流 / 同城页 / 社区页 /
#   搜索页 / 我的页面 / 订单页的全部内容改写与拦截规则（过滤过多、影响正常浏览）。
#   如日后需要旧版完整规则，可从仓库 git 历史取回（commit 2d30d84 及更早版本）。
#
# 开屏广告机制（2026-10-05 实测确认）：
#   ① splash.ads        开屏主接口（冷启动时请求广告数据）
#   ② splash.async.ads  开屏素材预取接口（提前拉素材入本地缓存，
#                       即「每天 0 点后又弹一次」的素材来源）
#   ③ 素材渲染依赖 App 本地缓存，故必须在接口层拒绝，拦图片 URL 无效。
#   ⚠️ host 为 acs.m.goofish.com（早期误写 acs.m.taobao.com 导致规则从未生效）。
# ============================================================

[Rule]
# 阻断开屏相关域名的 QUIC（HTTP/3）探测：QUIC 走 UDP，MITM 无法解密会让下面的改写失效。
# 被拒后 App 自动回落 TCP，功能不受影响；只精确到这三个域名，其它流量不做任何处理。
AND,((DOMAIN,acs.m.goofish.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,guide-acs.m.taobao.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# ---------- 开屏广告（本插件唯一的拦截目标）----------
# 开屏主接口：冷启动请求广告数据
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads\/.* reject-200
# 开屏素材预取接口：提前拉素材入本地缓存
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.async\.ads\/.* reject-200
# 首页开屏广告位（guide-acs 中台，防冷启动后进首页再弹）
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get reject-200
# 旧版本兼容：个别旧版本可能仍走 acs.m.taobao.com
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idlecommerce\.splash\.ads reject-200

[MITM]
hostname = acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com
