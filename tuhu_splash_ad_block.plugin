#!name=途虎
#!desc=拦截途虎养车 App 开屏/弹窗广告（mkt-gateway.tuhu.cn）；最佳努力规则，若仍出现请用 GKD 精准跳过；需开启 MITM 并信任证书
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/tuhu.jpg

[MITM]
hostname = mkt-gateway.tuhu.cn

[Rewrite]
# 途虎养车开屏/广告位（最佳努力，路径含 splash/advert/ad/popup 时拦截）
^https?://mkt-gateway\.tuhu\.cn/.*(splash|advert|ad|popup).* reject-200
