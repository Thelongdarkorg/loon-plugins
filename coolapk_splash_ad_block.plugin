#!name=酷安
#!desc=过滤酷安 App 广告（热搜 / 首页信息流 / 帖子详情推广卡 / 回复楼层 / 页面卡片 / 我的页面入口 / 开屏 SDK 广告域名）；纯本地规则，零远程脚本、不上报、不联网。需开启 Loon MITM 并信任证书。；规则更新 2026-09-18
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/coolapk.jpg
#!tag=去广告
#!system=ios

[Rewrite]
# 热搜广告位
^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch reject-dict

# 帖子详情页：剔除无 id 的推广楼层 + 推广卡片 / 带货卡片
^https:\/\/api\.coolapk\.com\/v6\/feed\/detail\? response-body-json-jq '.data.hotReplyRows |= if . then map(select(.id?)) else . end | .data.topReplyRows |= if . then map(select(.id?)) else . end | reduce ("detailSponsorCard", "include_goods", "include_goods_ids") as $key (.; .data[$key] = [])'

# 回复列表：剔除无 id 的推广楼层
^https:\/\/api\.coolapk\.com\/v6\/feed\/replyList response-body-json-jq 'if .data? and ((.data | type) == "array") and (.data | length > 0) then .data |= map(select(.id?)) else . end'

# 首页信息流：剔除推广卡片与「精选配件」
^https:\/\/api\.coolapk\.com\/v6\/main\/dataList response-body-json-jq '.data |= (if (type=="array" and length>0) then map(select((.entityTemplate!="sponsorCard") and (.title!="精选配件"))) else . end)'

# 页面卡片：剔除话题热议 / 酷安热搜 / 广告卡 / 指定专题实体，并清理卡片内推广
^https:\/\/api\.coolapk\.com\/v6\/page\/dataList response-body-json-jq '.data |= (if (type=="array" and length>0) then map(select((.title? != "话题热议") and (.title? != "酷安热搜") and (.entityTemplate? != "imageScaleCard") and (.entityTemplate? != "sponsorCard") and (.entityId? != 36104 and .entityId? != 24309 and .entityId? != 12889 and .entityId? != 21063 and .entityId? != 35730 and .entityId? != 35846 and .entityId? != 28374 and .entityId? != 28375 and .entityId? != 27332 and .entityId? != 20090 and .entityId? != 28773 and .entityId? != 29343 and .entityId? != 21106)) | if .entities then .entities |= map(select(.title? != "睡个好觉需要什么？")) else . end) else . end)'

# 首页 indexV8：剔除推广卡、指定实体与「值得买 / 红包」类
^https:\/\/api\.coolapk\.com\/v6\/main\/indexV8 response-body-json-jq '.data |= (if (type=="array" and length>0) then map(select((.entityTemplate? != "sponsorCard") and (.entityId? != 8639 and .entityId? != 29349 and .entityId? != 33006 and .entityId? != 32557 and .entityId? != 28621) and (((.title? // "") | test("值得买|红包")) | not))) else . end)'

# 首页 init：剔除指定实体入口与「关注」模块，并清理卡片内推广
^https:\/\/api\.coolapk\.com\/v6\/main\/init response-body-json-jq 'del(.data[]? | select(.entityId? == 944 or .entityId? == 945 or .entityId? == 6390 or .entityId? == 24455 or .entityId? == 36839 or .entityId? == 1635 or .title? == "关注")) | .data |= map(if .entityId? == 20131 then .entities |= map(select(.title? != "酷品")) else . end) | .data |= map(if .entities then .entities |= map(select(.entityId? != 1635 and .entityId? != 2261 and .entityId? != 1633 and .entityId? != 413 and .entityId? != 417 and .entityId? != 1754 and .entityId? != 1966 and .entityId? != 2274 and .entityId? != 1170 and .entityId? != 1175 and .entityId? != 1190 and .entityId? != 2258 and .title? != "关注")) else . end)'

# 我的页面卡片配置：剔除文字链推广
^https:\/\/api\.coolapk\.com\/v6\/account\/loadConfig\?key=my_page_card_config response-body-json-jq '.data |= map(select(.entityType != "textLink" and (.entityId != 1001 and .entityId != 1003 and .entityId != 1004 and .entityId != 1005)) | if .entities then .entities |= map(select(.entityType != "textLink")) else . end)'

# 开屏 / 信息流 SDK 广告投放（穿山甲 pangle 下发）
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk reject-200
^https?:\/\/[^\s/]*\.pangle\.cn\/(api\/ad|ad|splash|material).* reject-200

[MITM]
hostname = api.coolapk.com, api-access.pangolin-sdk-toutiao.com, *.pangle.cn
