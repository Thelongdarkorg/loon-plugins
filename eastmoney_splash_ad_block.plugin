#!name=东方财富开屏广告拦截
#!desc=拦截东方财富 App 开屏/广告（emdcadvertise.eastmoney.com）；需开启 MITM 并信任证书
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]

[MITM]
hostname = emdcadvertise.eastmoney.com, emdcadvertisepj.eastmoney.com, swdlcdn.eastmoney.com

[URL Rewrite]
# 东方财富开屏/广告位（核心）
^https?://emdcadvertise(?:pj)?\.eastmoney\.com/infoService/v\d reject-200
# 广告素材图
^https?://swdlcdn\.eastmoney\.com/app/adimg/ reject-dict
