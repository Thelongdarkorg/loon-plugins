#!name=豆瓣
#!desc=过滤豆瓣 App 开屏广告（断开开屏下发接口 + 拦截广告素材）；纯本地规则，零远程脚本、不上报、不联网；需开启 Loon MITM 并信任证书
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/douban.jpg

[Rule]
# QUIC 阻断（MITM 只支持 TCP，QUIC 走 UDP 无法拦截）
AND,((DOMAIN,api.douban.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,frodo.douban.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# ===== 开屏广告（空响应代替 reject-dict，避免市集等页面因等待广告接口超时报错）=====
# 开屏广告配置（返回空 data 即不展示开屏）
^https?:\/\/api\.douban\.com\/v\d+\/app_ads response-body-json-jq data="{}" status-code=200
# 通用广告位下发（返回空数组）
^https?:\/\/api\.douban\.com\/.*\/ad\/ response-body-json-jq data="[]" status-code=200
# 京东联盟开屏视频素材（替换为空响应）
^https?:\/\/storage\.360buyimg\.com\/material-video\/video\/[a-f0-9]{32}\.mp4$ reject-200
# 京东联盟开屏图片素材（替换为空响应）
^https?:\/\/img\d+\.360buyimg\.com\/pop\/jfs\/t\d+\/\d+\/\d+\/\d+\/\d+\/[A-Za-z0-9]{10,40}\/[A-Za-z0-9]{10,40}\.jpg$ reject-200
# 豆瓣 CDN 广告素材（空响应）
^https?:\/\/img\d+\.doubanio\.com\/view\/dale-online\/dale_ad\/ reject-200

[MITM]
hostname = api.douban.com, frodo.douban.com, img1.doubanio.com, img2.doubanio.com, img3.doubanio.com, img9.doubanio.com, *.360buyimg.com
