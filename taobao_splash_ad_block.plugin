#!name=淘宝开屏广告拦截
#!desc=拦截淘宝 / 闲鱼 App 的开屏与启动广告。需开启 MITM 并信任证书。注：2026-06 起淘宝已按监管整改大幅取消开屏广告，本插件作为防御性规则，无广告时无害。
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!system=ios

[URL Rewrite]
# 淘宝开屏/启动广告（阿里广告服务）
^https?://acs\.m\.taobao\.com/gw/mtop\.alibaba\.advertisementservice\.getadv reject-dict
# 淘宝 / 一淘 广告配置（含 etao_advertise）
^https?://acs\.m\.taobao\.com/gw/mtop\.alimama\.etao\.config\.query reject-dict
# 淘宝 splash 开屏广告
^https?://acs\.m\.taobao\.com/gw/mtop\.etao\.noah\.query.*tao_splash reject-dict
# 淘宝 O2O 广告网关
^https?://acs\.m\.taobao\.com/gw/mtop\.o2o\.ad\.gateway\.get reject-dict
# 闲鱼 / 淘宝二手 首页欢迎广告
^https?://acs\.m\.taobao\.com/gw/mtop\.taobao\.idle\.home\.welcome reject-dict
# 闲鱼 / 淘宝二手 开屏广告
^https?://acs\.m\.taobao\.com/gw/mtop\.taobao\.idlecommerce\.splash\.ads reject-dict
# 淘宝启动初始化里的广告位
^https?://acs\.m\.taobao\.com/gw/mtop\.alimusic\.common\.mobileservice\.startinit reject-dict

[MITM]
hostname = %APPEND% *.m.taobao.com
