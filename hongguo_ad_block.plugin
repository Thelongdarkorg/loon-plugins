#!name=红果短剧
#!desc=红果短剧·广告链路诊断版（分档测试）：分三档逐步加压，定位「剧集列表内嵌广告」的真实链路，档 1 → 档 1+2 → 档 1+2+3 依次试，观察广告是否消失；本版三档全部启用；纯本地规则，零远程脚本、不上报、不联网；全部为域名级拦截，无需开启 MITM，导入即生效；规则更新 2026-10-12 22:28
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/hongguo.jpg
#!tag=去广告
#!system=ios
#!date=2026-10-12 22:28

[Rule]
# ============================================================
# 【使用方法】
#   步骤1：只保留「档 1」启用，刷到广告出现的集数 → 看广告是否消失
#   步骤2：没消失 → 再启用「档 2」（档 1 保持启用）→ 再看
#   步骤3：还没消失 → 再启用「档 3」→ 再看
#   步骤4：三档全开仍无效 → 说明广告走 HTTPDNS + IP 直连，
#           域名层无解，需换方案（见文末）
# ⚠️ 本插件不含任何 DIRECT 放行规则，避免短路干扰诊断。
#    测试期间若正片异常（卡顿/黑屏），立即反馈。
# ============================================================

# ============ 档 1｜广告专属域（安全，不影响其他 App）============
DOMAIN-SUFFIX,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,log-api.pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-KEYWORD,reading-ad,REJECT
DOMAIN-KEYWORD,qznovelvod-ad,REJECT

# ============ 档 2｜字节公共广告接口（副作用：抖音/番茄同位置广告一起没）============
DOMAIN-KEYWORD,ads0-normal-,REJECT
DOMAIN-KEYWORD,ads1-normal-,REJECT
DOMAIN-KEYWORD,ads2-normal-,REJECT
DOMAIN-KEYWORD,ads3-normal-,REJECT
DOMAIN-KEYWORD,ads4-normal-,REJECT
DOMAIN-KEYWORD,ads5-normal-,REJECT
DOMAIN-KEYWORD,minigame,REJECT

# ============ 档 3｜字节 HTTPDNS 通道（激进）============
# 打断 App 自研 HTTPDNS，迫使回落系统 DNS，让域名规则重新生效
# ⚠️ 副作用：字节系 App（抖音/番茄/红果/头条）解析可能变慢或偶失败
# ⚠️ 不含 doh.pub / dns.alidns.com —— 那可能把 Loon 自身 DNS 也打断
DOMAIN-SUFFIX,dig.bdurl.net,REJECT

# ============ 附：整域暴力验证（默认关闭，逐条试，试完务必删）============
# 若上面三档都无效，取消下面某一条注释单独测，确认广告到底走不走该域
# DOMAIN-KEYWORD,zijieapi.com,REJECT
# DOMAIN-KEYWORD,snssdk,REJECT
# DOMAIN-KEYWORD,toutiao,REJECT
# DOMAIN-KEYWORD,pangolin,REJECT

# ============================================================
# 三档全开仍无效的备选方向
#   1. Loon → 仪表 → 请求日志，直接看广告出现那一刻的 host
#   2. 若 host 显示为裸 IP（无域名）→ 确认是 HTTPDNS/直连，
#      Loon 域名规则无能为力，需改用响应改写或 Hook 类方案
#   3. 若 host 有域名但不在上述清单 → 把域名发我，收窄靶点
# ============================================================
# 末次更新：2026-10-12 22:28
# ============================================================
