#!name=小红书开屏广告拦截+无水印
#!desc=拦截小红书 App 开屏/启动广告；并把笔记接口返回的图片/视频链接重写为无水印直链，实现「保存到相册无水印」。纯本地内联脚本（零远程代码），需开启 Loon MITM 并信任证书。效果依赖小红书接口结构，版本大改可能失效。
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!system=ios
#!ios=true

[URL Rewrite]
# 开屏广告配置：返回空响应，App 跳过开屏广告
^https?://edith\.xiaohongshu\.com/api/sns/v\d/system_service/splash_config reject-200
# 广告资源 / 曝光上报接口
^https?://www\.xiaohongshu\.com/api/sns/v1/ads/apple/record* reject
^https?://www\.xiaohongshu\.com/api/sns/v1/tag/ads_engage* reject
^https?://www\.xiaohongshu\.com/api/sns/v1/ads/resource* reject
# 广告矩阵开关
^https?://pages\.xiaohongshu\.com/data/native/matrix_switches* reject

[Script]
# 无水印：把接口返回的图片/视频链接重写为无水印直链
# 图片 sns-webpic-*.xhscdn.com/<...>/<图id>!后缀 -> sns-img-bd.xhscdn.com/<图id>
# 视频 用 video.consumer.originVideoKey -> sns-video-bd.xhscdn.com/<key>
http-response ^https?://(edith|rec|www)\.xiaohongshu\.com/api/sns/.* script-content=(function(){try{var b=JSON.parse($response.body);var ch=false;function fv(v){if(!v||typeof v!=="object"){return;}var k=null;if(v.consumer&&typeof v.consumer==="object"){k=v.consumer.originVideoKey;}if(!k||typeof k!=="string"||!k){return;}var c="https://sns-video-bd.xhscdn.com/"+k;if(v.media&&v.media.stream&&v.media.stream.length){for(var i=0;i<v.media.stream.length;i++){var s=v.media.stream[i];if(s.masterUrl){s.masterUrl=c;}if(s.backupUrls&&s.backupUrls.length){for(var j=0;j<s.backupUrls.length;j++){s.backupUrls[j]=c;}}ch=true;}}}function fi(u){var m=u.match(/sns-(?:webpic|img)[0-9a-zA-Z.-]*\.xhscdn\.com\/[0-9a-zA-Z\/]*?\/([0-9a-zA-Z_-]+)!/);if(m){ch=true;return "https://sns-img-bd.xhscdn.com/"+m[1];}return u;}function w(o){if(!o||typeof o!=="object"){return;}if(o.video&&typeof o.video==="object"){fv(o.video);}for(var k in o){var v=o[k];if(typeof v==="string"){if(v.indexOf("sns-webpic")>-1||v.indexOf("sns-img")>-1){o[k]=fi(v);}}else if(v&&typeof v==="object"){w(v);}}}w(b);if(ch){$done({body:JSON.stringify(b)});}else{$done({});}}catch(e){$done({});}})();, requires-body=true, timeout=60, tag=小红书无水印

[MITM]
hostname = edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com, pages.xiaohongshu.com, referee.xiaohongshu.com, ci.xiaohongshu.com
