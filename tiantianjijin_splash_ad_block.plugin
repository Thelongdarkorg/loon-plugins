#!name=天天基金
#!desc=拦截天天基金 App 开屏广告（清空开屏下发接口 GetAppStartImg 数据 + 精确拦截已下发的开屏图 URL，不误伤首页图片；并从首页配置 GetAppHome 移除顶部横幅广告 TopImgAd 与弹窗广告 HomePopupAd；实测图片可全拦，开屏退化为白屏空容器，容器随 App 打包、删除重装也无法消除，属 App 端行为）；纯本地规则，零远程脚本、不上报、不联网；需开启 MITM 并信任证书；规则更新 2026-09-24 16:33
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/tiantianjijin.jpg

# 说明：本插件全部为 Loon 原生规则，不含任何远程脚本。
#
# 开屏链路（2026-09-18 真机抓包定版；2026-09-22 抓包复验 + 接口实测后修订）：
#   ① 数据接口 appactive.1234567.com.cn/AppoperationApi/OperationService/GetAppStartImg
#      下发开屏数据，形如 {"resultCode":0,...,"datas":[{"Title":...,"ImgUrl":...}]}，
#      datas[].ImgUrl 即开屏图，实测全部是活动推广图。
#   ② 开屏图素材托管在 j5.dfcfw.com/WG/conf/<8 位日期>/N<30 位十六进制>.png。
#
# ⚠️ 为什么不用「按目录拦 /WG/conf/」（本插件前几版踩过的坑）：
#   /WG/conf/ 是运营位共用的 CMS 素材目录，**同目录、同命名，混着广告图与 UI 小图**。
#   2026-09-22 抓包复验再次证实：同一次冷启里，/WG/conf/20260920/N7a248119...png（299KB）
#   是开屏广告图（文案「如何穿越震荡行情」，右下角带「广告」标），
#   而 /WG/conf/20260921/N6a80910f...png（41KB）却是 GetAppHome 下发的**首页运营位 banner**
#   （「热点 市场风格再平衡…一键配置」）。二者形状完全一致（8 位日期目录 + N+30 位十六进制），
#   正则**无法按性质区分**，按目录拦会把首页图片一起打死（前版已 A/B 验证）。
#
# ✅ 本版做法：两条腿并用
#   腿① 改写开屏下发接口响应：保留响应信封（resultCode=0），只把 datas 清空。
#       ⚠️ 这里刻意**不再用 reject-dict（返回 {}）**：实测经验（京东 / 闲鱼 / 途虎 同源问题）
#       表明 App 收到 {} 会当成「接口异常」而**回退展示本地缓存的开屏**，表现为「隔几天偶发闪一次」。
#       返回「成功但零条开屏」才能真正压住。
#   腿② 精确拦截接口当前下发的图片 URL：覆盖 App 端已缓存、仍会去拉图的旧 URL。
#       只拦接口下发的那些 URL，完全不碰 /WG/conf/ 与 /WG/appconf/ 下的其他图片。
#
# ⚠️ 维护说明（重要）：开屏活动会轮换，图片 URL 随时变。下方 AUTO 块需**按需手动刷新**：
#   POST https://appactive.1234567.com.cn/AppoperationApi/OperationService/GetAppStartImg
#   （body {}、UA EMPro/10.0）→ 取 datas[].ImgUrl → 与区块已有行并集去重。
#   区块过期**不会造成误伤**（最坏只是漏拦某张图）；真正兜底的是腿①的接口规则。
#   最近一次刷新：2026-09-24 二次（并集去重后共 17 条，已覆盖接口当日下发的全部 5 条）。
#   ⚠️ 2026-09-23 / 09-24 两次复盘：开屏 campaign **1~2 天就全量轮换**（09-24 实测接口 4 条里 3 条是全新 URL，
#   StartTime 均为当日 00:00），而开屏图与首页图同目录同命名（如 20260923 目录下既有开屏图也有首页图），
#   无法按目录/命名区分，故本黑名单**必须高频刷新**，手写必然滞后 → 强烈建议改为定时自动拉接口生成本区块。
#   ✅ 2026-09-24 拿到 campaign 完整字段：每条都带 StartTime/EndTime（如 09-24~09-25），且接口持续有新 campaign（Id 已排到 2324+）。
#   2026-09-24 16:23 用户实证（第 8 次抓包 + 截图）：「删除 App」（非卸载）重装后多次启动，
#   开屏**立即**出现且请求的是 09-16/17/18 老 campaign 图 → campaign 配置**随 App 安装包自带**
#   （打包进二进制/内置配置），删除重装清不掉。图片腿拦截后残留「白屏 + 跳过倒计时 + 跳转按钮」
#   空容器 —— 这是网络层能达到的最优状态，容器本身只能 App 端去掉（网络手段不可达）。
#
#   动作演进：reject-200（空 body）→ reject-img（1×1 合法图）→ **本版 reject（直接断连）**。
#   reject-200 会被判「加载失败」→ 回退本地缓存图；reject-img 被判「加载成功」→ 渲染成透明，
#   但**开屏容器照常弹出（白屏 + 跳过倒计时）**。2026-09-24 实证 campaign 随安装包自带、
#   删除重装也消不掉容器，故改试 reject：让图片请求**硬失败**，赌 App 逻辑为「素材拉取失败 →
#   跳过本次开屏」，从而连白屏容器一起消除。最坏结果 = 维持 reject-img 时代的白屏（无缓存图可回退）。
#
# 已知边界：
#   - **实测「删除 App」重装后开屏依旧（2026-09-24）**：campaign 随安装包自带，重装无效；
#     插件能做的是把开屏压成「白屏空容器」（广告画面已不存在）。
#   - 开屏下发接口是 App 核心 API 域，若你的 App 版本对该域做了证书固定，
#     MITM 会失效 → 腿①不生效，此时靠腿②的精确 URL 兜住开屏（至少不显示广告图）。
#   - 本插件已实测：j5.dfcfw.com 与 appactive.1234567.com.cn 均无 Alt-Svc（不走 QUIC），
#     两域也都已加 QUIC REJECT 兜底。
#   - 接口变体已探测：GetAppStartImgV2 / GetStartImg / GetAppStartPic / GetAppLaunchImg 与
#     appactive2 域全部 404，即本接口是开屏 campaign 的**唯一**下发口；GetAppHome 只下发首页模块
#     （含 ImgUrl/Weight，但不含 ShowTime），不是开屏来源。

[Rule]
# ---------- 强制走 TCP（MITM 无法解密 QUIC，须先阻断 QUIC）----------
AND,((DOMAIN,j5.dfcfw.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,appactive.1234567.com.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,appconfig2.1234567.com.cn),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# ⚠️ 2026-09-24 抓包实证（关键）：本接口**只在特定时机请求，冷启不请求**。
#   证据：0 点后开屏发生时抓包，抓包的**第一个请求**就是开屏图
#   j5.dfcfw.com/WG/conf/20260916/N76245d18.png（证明完整覆盖了开屏阶段），
#   随后 +0.5s 是 GetAppHome、+1.2s 是两张首页 banner —— 全程 **0 次 GetAppStartImg**。
#   ⇒ App 把 campaign 列表**长期缓存在本地**：每次冷启直接读缓存 → 下载图 → 展示开屏。
#   ⇒ 所以下面这条腿①在冷启路径上**没有执行机会**（不是「失效」，是「没被触发」）。
#   ⇒ 2026-09-24 修正：实测「删除 App」重装后首启 t=0 即请求开屏图（早于一切配置接口），
#     且全包搜索无任何响应携带 campaign URL ⇒ campaign **随安装包自带**（非网络缓存），
#     腿①在该路径上没有执行机会属正常现象；删除重装不能消除开屏容器。
#   注：腿②（图片黑名单）在这条缓存路径上**是有效的** —— 2026-09-24 实测该开屏图被成功拦截
#   （抓包中该请求「无响应体」）。但拦掉图只会让开屏退化成「白底 + 跳过倒计时 + 跳转按钮」的
#   空容器，**无法消除开屏页本身**；要彻底不出现，必须让 App 手里没有有效 campaign。

#   2026-09-24：jq 由 `. as $o | try (...) catch $o` 简化为 `.datas = []` ——
#   本接口恒返回 JSON 对象（已实测：{"resultCode":0,"resultMessage":null,"updateTime":null,"datas":[...]}），
#   无需 try/catch 兜底，简化以排除复杂表达式在 Loon 内嵌 jq 引擎上的兼容性风险。
# ---------- 腿①：开屏广告下发接口 ----------
# 保留响应信封（resultCode=0），仅清空 datas —— 让 App 认为「今天没有开屏活动」；
# 不像 reject-dict 那样返回 {} 被当成接口异常、进而回退展示本地缓存的开屏
^https?:\/\/appactive\.1234567\.com\.cn\/AppoperationApi\/OperationService\/GetAppStartImg response-body-json-jq '.datas = []'

# ---------- 腿③：首页横幅/弹窗广告（GetAppHome 的 SpecialModules，2026-09-24 15:25 抓包新发现）----------
# GetAppHome（appconfig2.1234567.com.cn）的 datas.SpecialModules 里实测存在两个广告模块：
#   - TopImgAd（ModuldType 85005）：首页顶部横幅广告，campaign 1~2 天轮换（如 09-24~09-26）
#   - HomePopupAd（ModuldType 94）：首页弹窗广告，IntervalDay=7（每 7 天弹一次）
# 仅移除这两个模块，其余 SpecialModules（如 SearchHotWordHome）与全部 Modules 原样保留；
# 用 try/catch 兜底：响应结构异常时整包原样放行，绝不损坏首页配置。
# 配套删除 Content-MD5/ETag/Last-Modified：防 App 摘要校验失败丢弃响应、防 304 命中缓存跳过改写。
^https?:\/\/appconfig2\.1234567\.com\.cn\/config\/GetAppHome(?:\?.*)?$ response-body-json-jq '. as $o | try (.datas.SpecialModules = (.datas.SpecialModules | map(select(.ModuldType != 85005 and .ModuldType != 94)))) catch $o'
^https?:\/\/appconfig2\.1234567\.com\.cn\/config\/GetAppHome(?:\?.*)?$ response-header-del Content-MD5 ETag Last-Modified

# ---------- 腿②：开屏图素材（仅精确拦截接口当前下发的图片 URL）----------
# >>> AUTO-SPLASH-URLS BEGIN（每日 08:30/20:30 由 GitHub Actions 自动刷新，请勿手改本区块）>>>
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260922\/N66f8e7189b94d3686043b80a4665dd\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260924\/N31e1bbb63c742cfae5d7fcb2d6e457\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260923\/Nc43e602f63247b9b2017f2a0ad0cbc\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260923\/Nb5dc99753e44a299fa679cd16555f7\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260922\/N959e83852804522868b9447867eba7\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260920\/N7a248119e594866a365a7d4cd98369\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260918\/Nee5800636414a57822ad6cd673678d\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260918\/Ne3f45983f3f493bbfe24ce1e46621b\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260918\/N7ba57719a534240ae1b181b620d6c0\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260917\/N1af90777fc14303b1701b473d5fe0f\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260917\/N12c63dee75d43408a2641d62803c1a\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/Na2eb9a73e5a4a6aa3d5cf7a1bf51f1\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/N7d169cc42c14fd59205fd7203ac640\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/N76245d1830d40cdb6dc6d6a2db6fd5\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/N63d6f8212aa4b80a173b744e91af1d\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260915\/N5e0c93149dc47b1a9767df18155e46\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260914\/Nf1ac70b50f5416aa4176116951dd48\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260909\/Nce51fb0363c4bc0b6115e0eba57899\.png(?:\?.*)?$ reject
# <<< AUTO-SPLASH-URLS END <<<

[MITM]
hostname = j5.dfcfw.com, appactive.1234567.com.cn, appconfig2.1234567.com.cn
