^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20261020\/Nae0f6fec8954af497275cfe56b313c\.png(?:\?.*)?$ reject-img
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20261020\/Na8ff4763cd04ad692feb997727ceae\.png(?:\?.*)?$ reject-img
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20261015\/N8169d0935904ee9bfae6f9201c55db\.webp(?:\?.*)?$ reject-img
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20261014\/Nb77f7013cc04881a6b56ad2a5ae25d\.png(?:\?.*)?$ reject-img
