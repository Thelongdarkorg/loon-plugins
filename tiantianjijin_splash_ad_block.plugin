#!name=天天基金
#!desc=拦截天天基金 App 开屏/全屏弹窗广告（GetAppHome.HomePopupAd 决策删除 + GetAppStartImg 结构化清空 + 精确拦截开屏图 URL，不误伤首页图片）；自托管脚本经 jsdelivr 分发、可逐行审计、不上报；需开启 MITM 并信任证书
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/tiantianjijin.jpg
#!date = 2026-09-26 08:25

# 说明：本插件全部为 Loon 原生规则，不含任何远程脚本。
#
# 开屏链路（2026-09-18 真机抓包 + 接口实测取证）：
#   ① 数据接口 appactive.1234567.com.cn/AppoperationApi/OperationService/GetAppStartImg
#      下发开屏数据，形如 {"resultCode":0,...,"datas":[{"Title":...,"ImgUrl":...}]}，
#      datas[].ImgUrl 即开屏图（实测 5 条全部是活动推广图）。
#   ② 开屏图素材托管在 j5.dfcfw.com/WG/conf/<8 位日期>/N<30 位十六进制>.png。
#
# 【2026-09-26 新增通道】抓包证实（App 6.8.12 / iPhone）：
#   开屏式全屏弹窗已并入 appconfig2.1234567.com.cn/config/GetAppHome
#   → datas.SpecialModules 里 ModuleCode=HomePopupAd（ModuldType=94）：
#     ImgUrl + IntervalDay=7（每 7 天弹一次）+ StartTime/EndTime 活动期；
#   素材提前缓存本地，冷启动无任何图片下载请求 → 拦 URL 无效，必须在决策层删除该模块。
#
# 【2026-09-26 第四轮抓包重大发现：reject-dict 会触发本地兜底开屏】
#   实锤链条：脚本生效删掉 HomePopupAd 后，App 降级回退去请求旧接口
#   GetAppStartImg（第一轮无拦截时 0 请求；本 round 连发 3 次、每轮间隔 7.6s），
#   而 reject-dict 返回的 {} 缺 resultCode 等字段 → App 视为接口异常 →
#   重试失败后走「App 内置兜底开屏」（素材打包在 App 内，不走网络 →
#   抓包全程无开屏图下载请求，拦无可拦）。
#   ✅ 修复：放弃 reject-dict，改由 scripts/tt_startimg_strip.js 对该接口
#      返回「结构合法的无广告响应」——保留 resultCode 等原字段、仅清空
#      datas[] 开屏列表 → App 解析成功且拿不到任何素材。
#
# 【2026-09-26 08:25 最终实锤：开屏广告真正数据源 = HeadSudokuProduct.AdItems】
#   用户 08:17 开屏截图 × 3（skills升级/AI辅助/EveryClaw）与 GetAppHome 里
#   Modules[0].HeadSudokuProduct.AdItems 逐条比对，BckgrndImg 与背景色
#   逐像素吻合（如 "天天skills全面升级" = Ne0f…png，ColorValue #FF4D4D 红底）：
#   App 冷启动从 AdItems 按 Weight/Sort 轮换一条 → 全屏渲染（图+背景色+
#   点此跳转详情页[=ActivityLink]+跳过倒计时）。
#   ✅ 修复：tt_home_popup_strip.js 在删 HomePopupAd 基础上，同步清空
#      HeadSudokuProduct.AdItems（Items 正常功能格子原样保留）。
#
# ⚠️ 为什么不用「按目录拦 /WG/conf/」（本插件前几版踩过的坑）：
#   /WG/conf/ 是运营位共用的 CMS 素材目录，**同目录、同命名，混着广告图与 UI 小图**
#   —— 实测同目录下既有 286KB 的开屏广告图（"淘金节…广告"），也有 872B 的白色礼物盒
#   UI 图标，二者都是 N+30 位十六进制.png，正则**无法按性质区分**。
#   因此按目录拦会把首页图片一起打死。已用 A/B 验证：conf 规则因正则位数写错而失效
#   的那版，首页图标全部正常；规则一生效，首页图片就缺一半 → 证实 conf 里确实混着首页图片。
#
# ✅ 本版做法：**只精确拦截「开屏下发接口当前下发的那些图片 URL」**
#   —— 接口是「哪张图是开屏图」的唯一权威来源，据此命中即开屏图，
#      完全不碰 /WG/conf/ 与 /WG/appconf/ 下的其他图片。
#
# ⚠️ 维护说明（重要）：开屏活动会轮换，图片 URL 随时变。下方 AUTO 块由**每日自动任务**
#   刷新（取当天接口返回的 ImgUrl 并累积保留，以覆盖 App 端可能缓存的旧 URL）。
#   AUTO 块过期**不会造成误伤**（最坏只是漏拦某张图）；真正兜底的是上面那条接口规则。
#
# 已知边界：
#   - 开屏下发接口是 App 核心 API 域，若你的 App 版本对该域做了证书固定，
#     MITM 会失效 → 接口那条腿不生效，此时靠 AUTO 块的精确 URL 兜住开屏。
#   - 若开屏仍出现：多为 App 已缓存开屏图/配置，请先清除天天基金 App 的缓存或重装。
#   - 实测 j5.dfcfw.com 与 appactive.1234567.com.cn 均无 Alt-Svc（不走 QUIC）。

[Rule]
# ---------- 强制走 TCP（MITM 无法解密 QUIC，须先阻断 QUIC）----------
# 2026-09-26 08:20 升级：从 3 个域名扩展到整个域名族（DOMAIN-SUFFIX 覆盖全部子域）
# —— 排查发现抓包只能看到 TCP 流量，若素材走 QUIC/HTTP3（UDP）则 MITM 与抓包均为盲区；
#    QUIC 被拒后 App 自动回落 TCP，不影响功能
AND,((DOMAIN-SUFFIX,dfcfw.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,1234567.com.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,eastmoney.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# ---------- 开屏广告下发接口 ----------
# ⚠️ GetAppStartImg 的 reject-dict 已于 2026-09-26 08:05 移除（迁至 [Script] 段结构化清空）：
#    第四轮抓包实锤 reject-dict 返回 {} → App 判为接口异常 → 每 7.6s 重试 ×3 →
#    触发 App 内置兜底开屏（素材在 App 包内不走网络，拦无可拦）。
#    详见 [Script] 段 tt_startimg_strip.js 及文件头部「第四轮抓包重大发现」说明。

# 新通道（2026-09-26 抓包证实）：首页配置接口的 SpecialModules 里 ModuleCode=HomePopupAd
# 即全屏弹窗/开屏式广告决策（ImgUrl + IntervalDay=7 + 活动期），精准删除该模块；
# 搜索热词(SearchHotWordHome)与 10 个首页 Module 原样保留（已用真实响应验证）。
# ⚠️ 实测 response-body-json-jq 在本机未生效（2026-09-26 二次抓包：响应仍 79239B 原样未改写），
#    故改用自托管 script（Loon 对 http-response script 通路支持最稳，京东同款已验证）。
#    处理逻辑见 scripts/tt_home_popup_strip.js。

# ---------- 开屏图素材：仅精确拦截接口当前下发的图片 URL ----------
# >>> AUTO-SPLASH-URLS BEGIN（每日 08:30/20:30 由 GitHub Actions 自动刷新，请勿手改本区块）>>>
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260922\/N717e6f3405441ec80d1e5a120b5d5d\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260922\/N66f8e7189b94d3686043b80a4665dd\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260917\/N8cc381d88b8462aa2df9fdae530061\.png(?:\?.*)?$ reject
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/Na2eb9a73e5a4a6aa3d5cf7a1bf51f1\.png(?:\?.*)?$ reject-200
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260916\/N63d6f8212aa4b80a173b744e91af1d\.png(?:\?.*)?$ reject-200
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260915\/N5e0c93149dc47b1a9767df18155e46\.png(?:\?.*)?$ reject-200
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260914\/Nf1ac70b50f5416aa4176116951dd48\.png(?:\?.*)?$ reject-200
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260910\/N45c2e153e744932ac4950dcdc0cbdb\.png(?:\?.*)?$ reject-200
^https?:\/\/j5\.dfcfw\.com\/WG\/conf\/20260909\/Nce51fb0363c4bc0b6115e0eba57899\.png(?:\?.*)?$ reject-200
# <<< AUTO-SPLASH-URLS END <<<

[Script]
# 天天基金 GetAppHome 弹窗剥离（自托管脚本，零第三方依赖、可逐行审计）
# 脚本分发走 jsdelivr 镜像（raw.githubusercontent.com 在大陆网络拉取不稳定，
# 2026-09-26 三轮抓包证实 Loon 一直没拉到新版插件，故全链路改用 jsdelivr）
http-response ^https?:\/\/appconfig2\.1234567\.com\.cn\/config\/GetAppHome script-path=https://cdn.jsdelivr.net/gh/Thelongdarkorg/loon-plugins@main/scripts/tt_home_popup_strip.js, requires-body=true, tag=天天基金弹窗剥离

# GetAppStartImg 结构化清空（2026-09-26 08:05 起，替代 reject-dict）：
# reject-dict 的 {} 会被 App 判为异常 → 触发 App 内置兜底开屏（不走网络无从拦截）；
# 本脚本保留原响应结构、仅清空 datas[] 开屏列表 → App 解析成功且无素材可展示
http-response ^https?:\/\/appactive\.1234567\.com\.cn\/AppoperationApi\/OperationService\/GetAppStartImg script-path=https://cdn.jsdelivr.net/gh/Thelongdarkorg/loon-plugins@main/scripts/tt_startimg_strip.js, requires-body=true, tag=天天基金开屏数据清空

[MITM]
# 2026-09-26 08:20 扩展：+j3.dfcfw.com（图床，AUTO 精确 URL 需 MITM 才能命中）
# + *.1234567.com.cn 通配（自家 API 域全覆盖，消灭解密盲区；dfcfw 其余子域暂不扩以防证书固定）
hostname = j5.dfcfw.com, j3.dfcfw.com, appactive.1234567.com.cn, appconfig2.1234567.com.cn, *.1234567.com.cn
