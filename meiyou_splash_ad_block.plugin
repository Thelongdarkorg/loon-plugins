#!name=美柚
#!desc=过滤美柚 App 广告（开屏 / 弹窗推广 / 信息流推荐 / 青少年模式弹窗），并移除广告统计上报请求；纯本地规则，零远程脚本、不上报、不联网。需开启 Loon MITM 并信任证书。；规则更新 2026-09-18 15:26
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/meiyou.jpg
#!tag=去广告
#!system=ios

[Rule]
# 美柚广告素材 / 广告下发主域（域名级 REJECT，免 MITM 即生效）
DOMAIN, ad.seeyouyima.com, REJECT

[Rewrite]
# ----- 开屏 / 弹窗广告下发接口：返回空字典，App 视为无广告 -----
^https?:\/\/axxd\.xmseeyouyima\.com\/ad reject-dict
# ----- 广告预取与广告接口 -----
^https?:\/\/axxd\.xmseeyouyima\.com\/.*getad\? reject-dict
# ----- 广告曝光统计上报 -----
^https?:\/\/x\.seeyouyima\.com\/adx\/staticstics\? reject-200
# ----- 社区信息流推广 -----
^https?:\/\/circle\.(?:xm)?seeyouyima\.com\/v\d\/article_recommend\? reject-dict
# ----- 移除青少年模式弹窗卡片 -----
^https?:\/\/common\.seeyouyima\.com\/v2\/conf_list$ response-body-json-del data.confList.Minor_mode_card

[MITM]
hostname = axxd.xmseeyouyima.com, x.seeyouyima.com, circle.seeyouyima.com, circle.xmseeyouyima.com, common.seeyouyima.com
