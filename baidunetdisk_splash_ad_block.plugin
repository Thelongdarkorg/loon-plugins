#!name=百度网盘去广告
#!desc=拦截百度网盘 App 开屏瀑布流广告（微鲤/Menta/百青藤/穿山甲/优量汇）、首页顶栏广告、运营弹层、视频贴片及搜索栏广告；抖音流量优先放行，零远程脚本、不上报、不联网；需开启 Loon MITM 并信任证书
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/baidunetdisk.jpg
#!tag=去广告
#!system=iOS,iPadOS

[Rule]
# ===== 1. 抖音放行（必须在所有 REJECT 之前）=====
USER-AGENT,Aweme*,DIRECT
USER-AGENT,AwemeLite*,DIRECT
USER-AGENT,aweme*,DIRECT
DOMAIN-SUFFIX,douyin.com,DIRECT
DOMAIN-SUFFIX,iesdouyin.com,DIRECT
DOMAIN-SUFFIX,douyincdn.com,DIRECT
DOMAIN-SUFFIX,douyinvod.com,DIRECT
DOMAIN-SUFFIX,amemv.com,DIRECT
DOMAIN-SUFFIX,awemeughun.com,DIRECT
DOMAIN-SUFFIX,awemeinf.com,DIRECT
DOMAIN-KEYWORD,douyin,DIRECT

# ===== 2. 微鲤 / Menta =====
DOMAIN-SUFFIX,vlion.cn,REJECT
DOMAIN-SUFFIX,advlion.com,REJECT
DOMAIN-SUFFIX,mentamob.com,REJECT

# ===== 3. 趣萌（含 58iclick 备份域）=====
DOMAIN-SUFFIX,yunxish.com,REJECT
DOMAIN-SUFFIX,iggrowth.cn,REJECT
DOMAIN-SUFFIX,58iclick.com,REJECT

# ===== 4. 百青藤 =====
DOMAIN,afdconf.baidu.com,REJECT
DOMAIN,nsclick.baidu.com,REJECT
DOMAIN,bz-ipdx.baidu.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,cpro.baidu.com,REJECT
DOMAIN,nadvideo2.baidu.com,REJECT
DOMAIN,als.baidu.com,REJECT
DOMAIN,eclick.baidu.com,REJECT

# ===== 5. 穿山甲广告域（抖音 Aweme* 已在上面放行）=====
DOMAIN-SUFFIX,zijieapi.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT
DOMAIN,is.snssdk.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN,extlog.snssdk.com,REJECT

# ===== 6. 优量汇 =====
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,tdid.m.qq.com,REJECT
DOMAIN,amsweb-cdn-gz-1258344696.file.myqcloud.com,REJECT

[Rewrite]
# ===== 开屏开关 + 广告位（核心链路）=====
^https://pan\.baidu\.com/buy/ad/conf mock-response-body data-type=json data="{\"errno\":0,\"data\":{\"mode\":0,\"tag\":0,\"ecpm\":0,\"ecpm_v2\":0,\"tag_v2\":0,\"mode_v2\":0,\"ecpm_v2_original\":0}}" status-code=200
^https://pan\.baidu\.com/buy/ad/get mock-response-body data-type=json data="{\"errno\":0,\"data\":{}}" status-code=200
^https://pan\.baidu\.com/buy/ad/analytics reject-dict

# ===== 开屏竞价接口 =====
^https://pan\.baidu\.com/rest/2\.0/membership/advertise/dsp reject-dict
^https://pan\.baidu\.com/rest/2\.0/pcs/adv reject-dict
^https://pan\.baidu\.com/api/analytics\?.*(?:splash|bidding|iOS_key_splash|iOS_bidding) reject-dict

# ===== 只拦网盘植入的穿山甲（aid/sdkid=1371），放行抖音自有 MSSDK =====
^https://mssdk\.volces\.com/.+[?&](?:sdkid=1371|aid=1371|subaid=5184252) reject-200
^https://tnc\d[-a-z0-9]*\.zijieapi\.com/get_domains/.+[?&]aid=1371 reject-dict

# ===== 百青藤 / 微鲤 / Menta / 趣萌 =====
^https://afdconf\.baidu\.com/afd/platform reject-dict
^https://api-v3\.mentamob\.com/api/v2/config mock-response-body data-type=json data="{\"code\":0,\"data\":{\"ad\":{\"placement\":[]}}}" status-code=200
^https://api-nxs-v4\.mentamob\.com/ reject-dict
^https://.+\.vlion\.cn/ reject-200
^https://.+\.advlion\.com/ reject-200
^https://cpc-service-square\.(?:yunxish|iggrowth|58iclick)\.(?:com|cn)/ reject-dict
^https://(?:usr-api|logrcv|service|tracelog-debug)\.yunxish\.com/ reject-200

# ===== 运营弹层 & 导流卡 =====
^https://pan\.baidu\.com/act/api/activityentry mock-response-body data-type=json data="{\"errno\":0,\"data\":[]}" status-code=200
^https://pan\.baidu\.com/backtofront/funcguide/list mock-response-body data-type=json data="{\"errno\":0,\"data\":{\"list\":[]},\"show_msg\":\"\"}" status-code=200
^https://pan\.baidu\.com/act/v2/ipcultivate/noticelist mock-response-body data-type=json data="{\"errno\":0,\"data\":[]}" status-code=200
^https://pan\.baidu\.com/api/getconfig reject-dict
^https://pan\.baidu\.com/api/getsyscfg reject-dict
^https://pan\.baidu\.com/api/taskscore/tasklist reject-dict
^https://pan\.baidu\.com/rest/2\.0/membership/user\?method=gamecenter reject-dict
^https://pan\.baidu\.com/act/v2/welfare/list reject-dict

# ===== 视频贴片 / 搜索栏广告 =====
^https://pan\.baidu\.com/rest/2\.0/membership/product response-body-json-replace data.secondary_ad_video "0" data.advanced_search_before_banner 0 data.advanced_search_after_banner 0

[MITM]
hostname = pan.baidu.com, afdconf.baidu.com, api-v3.mentamob.com, api-nxs-v4.mentamob.com, mssdk.volces.com, *.zijieapi.com, *.vlion.cn, *.advlion.com, *.mentamob.com, *.yunxish.com, cpc-service-square.iggrowth.cn, cpc-service-square.58iclick.com
