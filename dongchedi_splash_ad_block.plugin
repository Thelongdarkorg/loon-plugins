#!name=懂车帝
#!desc=拦截懂车帝 App 开屏广告的视频素材下发（v26-dcar-ad.dcarvod.com，并做 -ad.dcarvod.com 版本无关兜底）；纯本地规则，零远程脚本、不上报、不联网；全部为域名级拦截，无需开启 MITM，导入即生效；规则更新 2026-10-10 15:25
#!author=FFDNS[https://github.com/Thelongdarkorg/loon-plugins]
#!icon=https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/dongchedi.jpg
#!tag=去广告
#!system=ios
#!date=2026-10-10 15:25

[Rule]
# ============================================================
# 懂车帝开屏广告拦截（纯域名级 REJECT，免 MITM）
# 实证：2026-10-10 冷启抓包，开屏广告视频由 v26-dcar-ad.dcarvod.com 下发 —
#       请求头 X-Tt-Tag: admannor、UA 含 tag:admannor 与 MDLTaskPlay、
#       video/mp4、Range 约 2.1MB（admannor = 其广告播放器标识）。
# 说明：Loon 抓包只记录可代理的 TCP/HTTP 会话；本 App 开屏的「决策/下发」
#       请求在 6 次冷启 + 2 份 HAR 中从未出现在 TCP 链路，判定走 QUIC/私有
#       通道 → 只能拦其素材桶，并对命中域名一并阻断 QUIC，防止改走 UDP 绕过。
# 边界：开屏若为图片创意（不走 dcarvod 桶）不覆盖；素材若已被本地缓存可能有残留。
# ============================================================

# ---------- ① 开屏广告视频素材桶（抓包实证） ----------
AND,((DOMAIN,v26-dcar-ad.dcarvod.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,v26-dcar-ad.dcarvod.com,REJECT

# ---------- ② 版本无关兜底 ----------
# 广告素材桶域名固定含 "-ad.dcarvod.com"（当前 v26，未来 v27… 仍命中）；
# 与内容桶 v26-dcar.dcarvod.com、小程序桶 v26-microapp-dcar.dcarvod.com 不冲突。
AND,((DOMAIN-KEYWORD,-ad.dcarvod.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-KEYWORD,-ad.dcarvod.com,REJECT
